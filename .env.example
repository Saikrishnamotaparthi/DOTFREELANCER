# Server-side only — never prefix these with VITE_, or they will be
# bundled into client JS and exposed publicly.

# The Gmail address that sends mail on your behalf.
GMAIL_USER=yourname@gmail.com

# A Google App Password (NOT your normal Gmail password).
# Generate one at: myaccount.google.com/apppasswords
# Requires 2-Step Verification to be turned on for the account.
GMAIL_APP_PASSWORD=

# Inbox that should receive new leads. Defaults to GMAIL_USER if unset.
CONTACT_TO_EMAIL=yourname@gmail.com
